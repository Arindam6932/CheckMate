{
  "name": "checkmate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc --noEmit -p server/tsconfig.json",
    "preview": "vite preview",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\""
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "firebase": "^11.1.0",
    "react-router-dom": "^7.1.1",
    "socket.io-client": "^4.8.1",
    "socket.io": "^4.8.1",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "firebase-admin": "^13.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "@types/node": "^22.10.5",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "tsx": "^4.19.2",
    "concurrently": "^9.1.2"
  }
}
